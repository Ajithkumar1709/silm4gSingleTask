LOAD 0x7E000000                              ;0x7E000000 - 0x7E004000, size: 4*64K=256K
{
    INIT 0x7E000000 0x2000                   ;8k
    {
        OBM_StartUp.o (Init, +First)         ; Startup code
        main.o (+RO)                        ; Place main() in a root region for the benefit of software breakpoints
        version_block.o (IMGVERBLOCK)
    }
	
    CODE  +0	0x0E000 ;             		;24k
    {
        * (+RO)                             ; Application code, including C library
    }

    ITCM  0x1000	0x00003000 ;             			;Second Exec region is ITCM; size:8K. NOTE: do not overlap with logo; not use 0x0 memory as 0x0 is a special address.
    {
        LzmaDec.o (+RO)                     ; LzmaDec code on ITCM
        FreqChange.o (PSRAM_FC)
    }
	
    DATA  0x7E010000	(0x17000) ;			;80K
    {
        * (+RW,+ZI)                         ; All RW and ZI Data
    }
	
    DTCM  0xB0021C00   0xE000 {
        OBM_StartUp.o (+RW,+ZI)
        fip.o       (+RW,+ZI)
        secboot.o   (+RW,+ZI)
    }
	
    SEC_KEY_BUF  0xB002FC00	EMPTY 0x400                   ; backup key at the end of DTCM
    {
        ; reserved 1KB for backup secure boot key info
        ; boot33, updater and logo all used this region to backup secure boot key info.
    }
	

    IMG_END +0 EMPTY 0x04{}
}


