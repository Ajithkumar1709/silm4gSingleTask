//ICAT EXPORTED FUNCTION - Audio , Voice , vpathPcmStreamControl 
 void vpathPcmStreamControl_Env ( void *data ) 
 {	 
 UINT16 cmdData [ 2 ] ;	 
	 
 _rxTxActivePointsBits = 0 ;	 
	 
 cmdData [ 0 ] = * ( ( UINT16 * ) data ) ;	 
 cmdData [ 1 ] = * ( ( UINT16 * ) data + 1 ) ;	 
	 
 /* Bit 8 : Rx Active point ( 0 - near Vocoder , 1 - Near Codec )	 
 * Bit 9 : Tx Active point ( 0 - near Vocoder , 1 - Near Codec ) */	 
	 
 if ( cmdData [ 0 ] )	 
 { /* Set bit 8 ==> Set Rx active point to " Near Codec " */		 
 _rxTxActivePointsBits = ( 1 << 8 ) ;		 
 }	 
	 
 if ( cmdData [ 1 ] )	 
 { /* Set bit 9 ==> Set Tx active point to " Near Codec " */		 
 _rxTxActivePointsBits |= ( 1 << 9 ) ;		 
 }	 
	 
DIAG_FILTER ( AUDIO , Voice , vpathPcmStreamControl_Env , DIAG_ERROR)  
 diagPrintf ( " vpathPcmStreamControl ; set _rxTxActivePointsBits to 0x%x " , _rxTxActivePointsBits );

	 
 }

