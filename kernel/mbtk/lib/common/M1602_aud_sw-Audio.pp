 void TEST_DumpGssp ( void * data ) 
 {	 
 UINT32 reg [ 7 ] = { 0 } , *pData = * ( ( UINT32** ) data ) ;	 
	 
 reg [ 0 ] = *pData ; /* SSCR0 */	 
