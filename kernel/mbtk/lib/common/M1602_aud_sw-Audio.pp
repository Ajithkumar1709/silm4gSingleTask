//ICAT EXPORTED FUNCTION - Audio , Voice , amrServiceDeActivate 
 void amrServiceDeActivate ( void ) 
 {	 
DIAG_FILTER ( AUDIO , Voice , amrServiceDeActivate_Called , DIAG_INFORMATION)  
 diagPrintf ( " L1 API called:amrServiceDeActivate , audioP.state= %e { Audio_Ctrl_State } " , audioP.state );

	 
	 
 if ( ( audioP.state != WAIT_FOR_CSDI_STOP ) &&	 
 ( audioP.state != WAIT_FOR_CSDI_STOP_AND_PCM_STREAM ) &&	 
 ( audioP.state != WAIT_FOR_CSDI_START ) &&	 
 ( audioP.state != WAIT_FOR_CSDI_START_AND_PCM_STREAM ) &&	 
 ( audioP.state != WBCDMA_VOICE ) &&	 
 ( audioP.state != WBCDMA_VOICE_AND_PCM_STREAM ) &&	 
 ( audioP.state != VOICE_HAND_OVER ) &&	 
	 
	 
	 
 ( audioP.state != VOICE_HAND_OVER_AND_PCM_STREAM ) )	 
 {		 
DIAG_FILTER ( AUDIO , Voice , amrServiceDeActivate , DIAG_ERROR)  
 diagTextPrintf ( " Cannot end csdi connection - AMR state is invalid " );

		 
 return ;		 
 }	 
	 
	 
 switch ( audioP.state )	 
 {		 
 case WAIT_FOR_CSDI_STOP:		 
 case VOICE_HAND_OVER:		 
 case WAIT_FOR_CSDI_START:		 
 case WBCDMA_VOICE:		 
		 
		 
		 
 vpathStop ( 1 ) ;		 
 audioP.state = VOICE_IDLE ;		 
 break ;		 
 case WAIT_FOR_CSDI_STOP_AND_PCM_STREAM:		 
 case VOICE_HAND_OVER_AND_PCM_STREAM:		 
 case WAIT_FOR_CSDI_START_AND_PCM_STREAM:		 
 case WBCDMA_VOICE_AND_PCM_STREAM:		 
 audioP.state = PCM_STREAM_ONLY ;		 
 vpathSelfInvocation ( 1 , vpathIsEncSelfInvoked ( ) , 0 ) ;		 
 // start voice path for pcm streaming only		 
 if ( !vpathIsActive ( ) )		 
 vpathStartDefault ( ) ;		 
 // attempt to do resumption\suspension if required on PCM streaming		 
 pcmStreamHandle ( audioP.state ) ;		 
 vpathMuteControl ( RX_MUTE , pacAudioFarSideMuteSts , 0 ) ;		 
 vpathMuteControl ( TX_MUTE , pacAudioNearSideMuteSts , 0 ) ;		 
 break ;		 
 default:		 
 // this default never can be reached!		 
 audioP.state = VOICE_IDLE ;		 
 }	 
	 
 }

