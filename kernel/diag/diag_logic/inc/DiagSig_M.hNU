//This is a duplicate of the enum in KIOSTTI.C in order to determine if the Genie Task is running or not
typedef enum GenieTestStateTag
{
    GENIE_TEST_TO_BE_STARTED,
    GENIE_TEST_RUNNING,
    GENIE_TEST_WAIT,
    GENIE_TEST_DELAY,
    GENIE_TEST_STOPPED
}
GenieTestState;

