typedef enum L1KiSigBaseTag
{
	/*
	** WARNING:
	** All signal groups bases should be a multiple of 0x0100
	** 
	** NOTE: ANY CHANGE OF THE VALUES BELOW MUST BE SYNCED WITH PS.
	*/

	SYS_GROUP_BASE          =   0x00100,
	MPH_GROUP_BASE          =   0x030000,
	PH_GROUP_BASE           =   0x030100,
	TI_GROUP_BASE           =   0x030200,




	CDMG_GROUP_BASE         =   0x030400,
	GPGMPH_GROUP_BASE       =   0x030500,
	UMPH_GROUP_BASE         =   0x030800,
	EMPH_GROUP_BASE			=	0x031100,
	GPLCSPY_GROUP_BASE      =   0x031200,
	CB_GROUP_BASE           =   0x060200,

	NUM_GROUP_BASES
}
L1KiSigBase_te;



/* END OF FILE */
