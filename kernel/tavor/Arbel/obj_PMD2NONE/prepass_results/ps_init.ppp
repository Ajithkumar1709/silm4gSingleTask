	Boolean mncThreeDigitsDecoding; /**< Is three digit encoding used. */
	/* @ITEM_DESC@ Is three digit encoding used @ITEM_MODE@ ReadWrite @ITEM_UNIT@ on/off (0-not active, 1-active) */
}
SimPlmn;

