MST_MCT_SIGNAL_BASE = (KI_BASE_INDEX_MST_MCT - 1) * 0x0100, /* Coolart Signals exchanged between MST and MCT */
PST_MST_SIGNAL_BASE = (KI_BASE_INDEX_PST_MST - 1) * 0x0100, /* Coolart Signals exchanged between PST and MST */
GPIB_NI_SIGNAL_BASE = (KI_BASE_INDEX_GPIB_NI - 1) * 0x0100, /* Coolart Signals to communicate with a test instrument using a National Instrument USB to GPIB converter.
