    COMMON_RESERVED_1_IPV4_TRACE,                   /*position 1 ,IPV4 trace*/
    COMMON_RESERVED_2_EIA0,                         /*position 2, WARNING: Capability, need restart to take effect : as NVM control to enable/disable EIA0 use  */
