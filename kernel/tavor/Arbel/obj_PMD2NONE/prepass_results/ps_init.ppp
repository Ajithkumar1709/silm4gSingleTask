/***************************************************************************
 * Type Definitions
 **************************************************************************/

/** GKI Unit Queue structure.
 * Unit Queues are used to store signals within a task after they have been
 * removed from the tasks input queue. A Unit Queues must only be accessed
 * by a single task (accessing from multiple threads is not supported).
 * The fields within the unit queue structure should not be accessed directly
 * outside the GKI code. The API for manipulating unit queues is defined
 * in gkiqueue.h. */
typedef struct KiUnitQueueTag
{


















     
    /* maximum number of signals that can be stored in the circular buffer */
    Int16                           numberInBlock;
    /* the memory block */
    void                           *block;
    /* the head index */
    Int16                           head;
    /* the queue length */
    Int16                           length;
      
}
KiUnitQueue;

/** @} */ /* End of PrdGki group */



/* END OF FILE */
# 37 "\\3g_ps\\rls\\tplgsm\\bldstore\\hsiupdlibdev\\build\\lib\\hsiupdlibdev_BldIncCache\\gkiqueue.h"

/***************************************************************************
 * Typed Constants
 **************************************************************************/

extern const KiUnitQueue  kiNullUnitQueue;

/***************************************************************************
 * Kernel Function redirections
 **************************************************************************/







/***************************************************************************
 * Function prototypes
 **************************************************************************/

void       KiOsEnqueue             (KiUnitQueue         *queue,
                                    SignalBuffer        *signal);

void       KiOsDequeue             (KiUnitQueue         *queue,
                                    SignalBuffer        *signal);

Boolean    KiOsOnQueue             (KiUnitQueue         *queue);

Int32      KiOsNumOnQueue          (KiUnitQueue         *queue);

void       KiOsFlushQueue          (KiUnitQueue         *queue);





