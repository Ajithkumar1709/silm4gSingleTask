 *
 * Notes:
 *
 ***********************************************************************/
 extern OSA_STATUS OSAFlagWait(
    OSFlagRef   flagRef,
    UINT32      mask,
    UINT32      operation,
    UINT32      *flags,
    UINT32      timeout
 );
