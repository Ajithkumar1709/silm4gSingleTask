 *  UINT32                  operation         [IN]    OSA_FLAG_AND, OSA_FLAG_AND_CLEAR,  OSA_FLAG_OR, OSA_FLAG_OR_CLEAR.
 *  UINT32                  *flags       	 	[OUT]    Current value of all flags
 *  UINT32                  timeout       	[IN]    OS_SUSPEND, OS_NO_SUSPEND, or timeout
 *
