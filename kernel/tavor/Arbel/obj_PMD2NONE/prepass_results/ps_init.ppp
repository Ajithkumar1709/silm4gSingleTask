ATI_SIGNAL_BASE = (KI_BASE_INDEX_ATI - 1) * 0x0100,     /* Coolart Signals exchanged between MST and ATI task. */
BAMM_SIGNAL_BASE = (KI_BASE_INDEX_BAMM - 1) * 0x0100,    /* Coolart Signals exchanged between MST and BAMM task */
PWRCTRL_SIGNAL_BASE = (KI_BASE_INDEX_PWRCTRL - 1) * 0x0100, /* Coolart Signals exchanged between MST and PWRCTRL task */
CA_UTIL_SIGNAL_BASE = (KI_BASE_INDEX_CA_UTIL - 1) * 0x0100, /* Signals exchanged between MST and CoolART Utility passthru task */
LPT_SIGNAL_BASE = (KI_BASE_INDEX_LPT - 1) * 0x0100,     /* CoolArt Signals exchanged between MST and LPT task */


