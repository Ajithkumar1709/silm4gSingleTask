    systemfeatureenable_ts GRR_LOG_RET_TO_IDLE_L3MSG; /* @ITEM_DESC@ Messages received in MphUnitDataInd while returning to idle state, @ITEM_MODE@ ReadWrite, @ITEM_UNIT@ Enable/Disable */
