typedef enum CommonReservedFeatureTag
{
    COMMON_RESERVED_0_Hot_Reset =0,                 /*position 0 ,hot reset feature*/
    COMMON_RESERVED_1_IPV4_TRACE,                   /*position 1 ,IPV4 trace*/
    COMMON_RESERVED_2_EIA0,                         /*position 2, WARNING: Capability, need restart to take effect : as NVM control to enable/disable EIA0 use  */
    COMMON_RESERVED_3_IPV6_TRACE,                   /*position 3, IPV6 trace*/
    COMMON_RESERVED_4_CTA_SINGLE_ANTENNA,           /*position 4,CTA single antenna test*/
    COMMON_RESERVED_5_zIPV4_Trace,                  /*position 5, merged from MP_Z CC branch for IPV4 len*/
    COMMON_RESERVED_6_zIPV6_Trace,                  /*position 6, merged from MP_Z CC branch for IPV6 len*/
    COMMON_RESERVED_7_noBenFromBatConsumpOpt,       /*position 7, WARNING:Capability,  need restart to take effect opt for noBenFromBatConsumpOpt present in DeviceType*/
    COMMON_RESERVED_8_Fasten_Register,              /*position 8, opt for specific IOT without 4G to fasten registration,  fasten registration to 2/3G when rejected by attach reject#19, #468*/
    COMMON_RESERVED_9_NW_Mode,                      /*position 9, opt for no detach/attach for AT*BAND initated 23G NW mode change, #523*/
    COMMON_RESERVED_10_Limit_EF_update,             /*position 10, opt for limit EF update for StartCS/PS , #1007*/
    COMMON_RESERVED_11_Cid_Remapping,               /*position 11, opt for remapping PS cid(default 5) since NW rejects 2nd same APN, #1043*/
    COMMON_RESERVED_12_Invalid_KSI,                 /*position 12, opt for using invalid KSI(7) in case not power off normally, #1527;*/
    COMMON_RESERVED_13_Initial_APN_Cid ,            /*position 13, opt for setting LTE initial APN cid map from ebi/nsapi , #1656*/
    COMMON_RESERVED_14_NonStandard_Attach,          /*position 14, opt for implementing non-standard requirement for attach/tau*/
    COMMON_RESERVED_15_AttachRej_Disable_EITF,      /*position 15, opt for disable EITF to retry attach when attach reject*/
    COMMON_RESERVED_16_disable_audio_path,          /*position 16, if 1, disable audio path*/
    COMMON_RESERVED_17_CONFIG_DISABLE_EUTRAN_TIMER, /*position17, opt for configurate EnableEutranTimer for customer requirement, the value (noZero) represents the timer period value, the unit is in minutes, if the value is 255(FF) , it has two senses: one means don't start EnableEutranTimer only at disableEutran is triggered by twice attachReject/tauReject#15; another means the timer period value is 255 minutes*/
    COMMON_RESERVED_18_rat_to_notAllowedCellList,   /*position18, opt for rat to not allowed cell list*/
    COMMON_RESERVED_19_disable_Eutran_CAUSE_15,     /*position19, opt for specific SIM without 4G to fasten registration to 2/3G when rejected by TA forbidden(#15), the value  is 0,1,2; 0 indicates disable, 1/2 indicates the attachReject#15 counter, once reach the max counter, disableEutran will be executed #4528*/
    COMMON_RESERVED_20_igore_CS_Paging,             /*Position20, ignore the 2/3/4G CS paging when PPP/TCP service is ongoing*/
    COMMON_RESERVED_21_NonStandard_gsm_attach,      /*Position21, reset the reject cause gmmAttachReject#111, gmmRauAttachReject#111 to #9*/
    COMMON_RESERVED_22_ResetMainTimerValueToZero_psNewWorkInValid,  /*Position22, when T3318/T3320 timeout, restart the mainTimer zero seconds, execute attach/rau immediately*/
    COMMON_RESERVED_23_FromPTMtoIdle_whenNotReceiveAckFromNW,       /*Position23, when Grr doesn't revece ACK from Network, GRR return Idle from PTM*/
    COMMON_RESERVED_24_GPLC_shortenSearchNumberOfTime,              /*Position24, gplc shorten the search number of timer from 5 to 3, each frequency #5728*/
    COMMON_RESERVED_25_Band62Earfcn,                                /*position25,opt for band 62 earfcn requirement , */
    COMMON_RESERVED_26_LowLevelCamping,                             /*position26, enable/disable lowLevelCamping through at+medcr, #4457, CQ00115716*/
    COMMON_RESERVED_27_REGISTER_TO_23G_SUCCESS_STOP_TAFORBIDDEN_TIMER, /*Postion27,UE is SR reject#15 at LTE,  go to 23G RAU successfully, then stop TAForbiddenTimer, #6560*/    
    COMMON_RESERVED_28_UE_EVENT_REPORT,                             /*position28,opt for reporting ue event: YOUFANG  #5221, */
    COMMON_RESERVED_29_RRC_CONNECTION_SETUP_OR_RELEASE_REPORT,      /*position29,RRC CONNECTION setup/release event report: YIYUAN  #3747, */    
    COMMON_RESERVED_30_CellChangeReport,                            /*position30,cell change report for kido360  #7449, */
    COMMON_RESERVED_31_ControlNumberOfTimersForRach,                /*position31,control the number of timers for rach  #CTA test 6.2.2.6 and IMS cases grr liuke 20190918, */

    
    COMMON_RESERVED_NUM = 32
}
Common_Reserved_Feature;
