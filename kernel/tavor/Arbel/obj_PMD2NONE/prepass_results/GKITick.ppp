}
OsaSisrPriorityT ;

typedef struct
{
    UINT32      *SisrStackPtr[(int)OSA_SISR_MAX_PRIORITY] ;     //  [OP,IN] SISR Stack Pointers.
    UINT32      SisrStackSize[(int)OSA_SISR_MAX_PRIORITY] ;     //  [IN]    SISR Stack Size.
}
OsaInitParamsT ;


