    typedef enum
    {
		PM_PS_OPERATIONAL_D0=0,
		PM_PS_CORE_LPM_C1,
		PM_PS_D1,
		PM_PS_D2,
		PM_PS_D3,
		PM_PS_D4,

		/* For general WakeUp register that is active from any Dx state to any Dx state */
		PM_PS_ANY_DSTATE,

		/* on exit from LPM - special transition values */
		PM_PSEXIT_C1,
		PM_PSEXIT_D2,
		PM_PSEXIT_D2_interrupted,	// Harbell 
		PM_PSEXIT_D3,

		PM_NUM_OF_POWER_STATES 

    }PM_PowerStatesE;

