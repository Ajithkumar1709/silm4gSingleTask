    void                        *pForFutureUse
    ) ;

 extern OSA_STATUS  OsaSemaphoreDelete(
    OsaRefT                     OsaRef,             //  [IN]    Reference.
    void                        *pForFutureUse
    ) ;

/*========================================================================
