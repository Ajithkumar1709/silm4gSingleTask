 *  UINT32                  		pOOLsIZE       	[IN]      number of bytes in the memory pool
 *  UINT32                  		pARTsIZE       	[IN]     size of partitions in fixed pools
 *  UINT8                 	 	sUSPEND         [IN]    mode of tasks waiting OS_FIFO, OS_PRIORITY
 *
