	PM_RR_POWER_ON_RESET,
	PM_RR_COMM_SUBSYSTEM_RESET,
	PM_RR_WATCHDOG_TIMEOUT_RESET,
	PM_RR_LPM_EXIT_RESET,			
	PM_RR_GPIO_RESET
}PM_LastResetReasonE;

