	UINT8 usatProfile[64] = {0x3F,0x01,0xED,0xE0,0x19,0x90,0x00,0x07,0x84,0x00,0x00,0x00,0x00,0x60,0x00,0x00,0x43,0xC0,0x00,0x00,0x00,0x00,0x40};
