typedef enum
{
    PM_RC_OK = 0,
	PM_RC_FAIL	,			//General Failure
	PM_RC_ALREADY_EXISTS	//Exit function since required target alrteady exists
}PM_ReturnCodeE;

// Reasons of Last Reset -
