/*add by xyma for CQ00125818 begin*/
//UINT8 ctxflag = 200;
 /* Added by Daniel for PSM 20180201, begin */
//BOOL psNvmReadPsmContext(void)

extern  UINT8 * getPSPsmContextP(UINT8 simId);
BOOL psNvmReadPsmContext(UINT8 simId)
{
# 220 "\\tavor\\Arbel\\src\\ps_nvm.c"

    FILE_ID				fdiID;
	FILE_INFO 			fileInfo;
	NVM_Header_ts	header;
	UINT8 *gPsPSMContextP = 0;
	
//	bReadPsm[0] = 0;
//	bReadPsm[1] = 0;
	  	  
	if(simId == 0)
	{		
	    if (FDI_findfirst("PsmContextProfile.nvm", &fileInfo) != 0)
	    {
	      DIAG_FILTER(SYSTEM, SYSNVM, psNvmReadPsmContext_01,DIAG_INFORMATION)
	      diagPrintf ("File %s doesn't exist - using System defaults", "PsmContextProfile.nvm");
	    //  ctxflag = 1;
	      return(0);
	    }
	}
	else
	{
		if (FDI_findfirst("PsmContextProfile1.nvm", &fileInfo) != 0)
	    {
	      DIAG_FILTER(SYSTEM, SYSNVM, psNvmReadPsmContext_02,DIAG_INFORMATION)
	      diagPrintf ("File %s doesn't exist - using System defaults", "PsmContextProfile1.nvm");
	  
	      return(0);
	    }
	}
	  
	/* '0' open fail, !'0' open ok. */
	if((fdiID = FDI_fopen(fileInfo.file_name,"rb")) == 0)
	{
	  if(simId == 0)
	  {		  
	      DIAG_FILTER(SYSTEM, SYSNVM, psNvmReadPsmContext_03,DIAG_INFORMATION)
	      diagPrintf ("File %s OPEN error!", "PsmContextProfile.nvm");
		  //ctxflag = 2;
      }	  
	  else
	  {
		   DIAG_FILTER(SYSTEM, SYSNVM, psNvmReadPsmContext_4,DIAG_INFORMATION)
	      diagPrintf ("File %s OPEN error!", "PsmContextProfile1.nvm");
	  }
	  return(0);
	}

	
    if(simId == 0)
	{		
	    DIAG_FILTER(SYSTEM, SYSNVM, psNvmReadPsmContext_05, DIAG_INFORMATION)
	    diagPrintf("Read %d words from file %s", fileInfo.size-sizeof(NVM_Header_ts), "PsmContextProfile.nvm");
	}
	else
	{
		DIAG_FILTER(SYSTEM, SYSNVM, psNvmReadPsmContext_06, DIAG_INFORMATION)
	    diagPrintf("Read %d words from file %s", fileInfo.size-sizeof(NVM_Header_ts), "PsmContextProfile1.nvm");
	}
	 
	 gPsPSMContextP = getPSPsmContextP(simId);
	if(gPsPSMContextP == 0)
		 return(0);
	
	/* Read the header first */
	FDI_fread((void *)(&header),1, sizeof(NVM_Header_ts),fdiID);
	
	if(simId == 0)
	{
	   // FDI_fread((void *)(&psmContext[0]),1, fileInfo.size-sizeof(NVMFormatHeader_ts),fdiID);
		 FDI_fread((void *)gPsPSMContextP,1, fileInfo.size-sizeof(NVM_Header_ts),fdiID);

//		ctxflag = psmContext[0].flag;
       //  bReadPsm[0] = 1;
	}
	else
	{
		//FDI_fread((void *)(&psmContext[1]),1, fileInfo.size-sizeof(NVMFormatHeader_ts),fdiID);
		FDI_fread((void *)gPsPSMContextP,1, fileInfo.size-sizeof(NVM_Header_ts),fdiID);
		//bReadPsm[1] = 1;
	}
	FDI_fclose(fdiID);
   
    return 1;


}

void psNvmSavePsmContext(UINT8 *psmCtx, unsigned char simId, unsigned short psmSize)
{
# 333 "\\tavor\\Arbel\\src\\ps_nvm.c"

	FILE_ID  fdiID;
	//UINT32 StructSize = sizeof(PsmContext);
	
	NVM_Header_ts  header;
	
	if(simId == 0)
	{
	    DIAG_FILTER(SYSTEM, SYSNVM, psNvmSavePsmContext_01,DIAG_INFORMATION)
	    diagPrintf ("Save %s from PSM context", "PsmContextProfile.nvm");
	
        fdiID = FDI_remove("PsmContextProfile.nvm");
	
	    fdiID = FDI_fopen("PsmContextProfile.nvm","wb+");
    }
	else
	{
		DIAG_FILTER(SYSTEM, SYSNVM, psNvmSavePsmContext_02,DIAG_INFORMATION)
	    diagPrintf ("Save %s from PSM context", "PsmContextProfile1.nvm");
	
        fdiID = FDI_remove("PsmContextProfile1.nvm");
	
	    fdiID = FDI_fopen("PsmContextProfile1.nvm","wb+");
	}

	/* '0' open fail, !'0' open ok. */
    if(fdiID != 0)
    {
		// Create NVM standard header
		FDI_CreateNVMFormatHeader(&header, psmSize, 1,"PsmContext","4.0","0", "0");
		FDI_fwrite(&header, sizeof(NVM_Header_ts), 1, fdiID);
       // FDI_fwrite (psmCtx, sizeof(PsmContext),1, fdiID );
	   FDI_fwrite (psmCtx, psmSize,1, fdiID );
        FDI_fclose(fdiID);
    }
	
    


}
extern unsigned short getPsPsmConextLen(void);
void psInitPsmContextNvm(UINT8 simId)
{
	unsigned short len = 0;
	UINT8* pTmp = 0;  
	len = getPsPsmConextLen();
	pTmp = malloc(sizeof(len));
	{ if (!(pTmp != 0)) { utilsAssertFail(0, "ps_nvm.c", 380, 1); } };
	
	memset(pTmp, 0, sizeof(len));
	psNvmSavePsmContext(pTmp, simId, len);
	//psNvmSavePsmContext(pTmp, 1, len);
	 free(pTmp);
}

