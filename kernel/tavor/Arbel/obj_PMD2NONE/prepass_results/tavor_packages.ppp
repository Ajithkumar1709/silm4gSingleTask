    OSMailboxQRef   *mboxQRef,      /* OS mailbox queue reference              */

    char            *queueName,     /* name of mailbox queue                   */

    UINT32          maxNumber,      /* max # of messages in the queue          */
    UINT8           waitingMode     /* mode of tasks waiting OS_FIFO, OS_PRIORITY */
 );


