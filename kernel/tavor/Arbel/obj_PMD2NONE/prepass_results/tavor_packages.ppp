    char                *name ;                 //  [OP]    Pointer to a NULL terminated string.
    BOOL                bSharedForIpc ;         //  [OP]    TRUE - The object can be accessed from all processes.
    UINT8               priority ;              //  Task priority.
}
OsaTaskCreateParamsT ;

