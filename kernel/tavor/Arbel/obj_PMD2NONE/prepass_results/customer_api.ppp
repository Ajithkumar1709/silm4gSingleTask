int cust_error_code_hanler(int err_code)
{
    switch(err_code)
    {
        case 0x50000000+0x00000002:
        case 0x60000000+0x00000003:
            return 11;
		case 0x50000000+0x00000004:
		case 0x60000000+0x00000001:
			return 104;
    }

    return err_code;
}

