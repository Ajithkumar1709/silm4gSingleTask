	PMC_TYPE_MICCO_C1_DB,
	PMC_TYPE_MICCO_C1_EA,
	PMC_TYPE_MICCO_C1_EB,
    PMC_TYPE_LEVANTE_A0,
    PMC_TYPE_LEVANTE_A1,
    PMC_TYPE_LEVANTE_B0,
    PMC_TYPE_UNKNOWN,  //add new types before this line
    PMC_TYPE_MAX = PMC_TYPE_UNKNOWN
}PMC_TYPE;

typedef enum
{
  MICCO_ID_A0 		= 0x00,
  MICCO_ID_B0       = 0x10,     //The names MICCO_B0, PMC_MICCO_B0 are already used with defines.
  MICCO_ID_C0 		= 0x20,
  MICCO_ID_C1_DB 	= 0x21,
  MICCO_ID_C1_EA 	= 0x30,
  MICCO_ID_C1_EB 	= 0x31,
  LEVANTE_ID_A0 	= 0x40,
  LEVANTE_ID_A1 	= 0x41,
  LEVANTE_ID_B0 	= 0x48
} PMIC_ID;

