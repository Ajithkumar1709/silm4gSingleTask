/*func: pmsg_pmsg_set*/
/*key parameter is msg, fn, phdr*/
/*some time, len and type no care, can set 0*/
static inline void pmsg_pmsg_set(pmsg *msg, free_fn fn, void *phdr, int plen, int type)
{
    if(msg) {
        msg->free = fn;
        msg->phdr = phdr;
        msg->plen = plen;
        msg->type = type;
    }
}

static inline void pmsg_pmsg_copy(pmsg *msg_dest, pmsg* msg_src)
{
    if(msg_dest && msg_src) {
        /*
        * restore msg from msg_src first, than use this to assign msg_dest
        * avoid msg_src and msg_dest just exist in same memory, but re-assign again.
        * if exist shift, like wifi pading, lwip set to 0 but if wifi module set to 2,
        * then the packet send from wifi and reply to wifi, the msg re-assgin will exit 2 bytes shift
        * then directly re-assign will task risk for re-write the buf
        */
        pmsg pmsg_store = *msg_src;
        msg_dest->free = pmsg_store.free;
        msg_dest->phdr = pmsg_store.phdr;
        msg_dest->plen = pmsg_store.plen;
        msg_dest->type = pmsg_store.type;
    }
}

static inline void pmsg_pbuf_set_mem(struct pbuf* p, void* pkt_hdr, void*pkt_mac, pmsg* pkt_msg)
{
    if(p->type == PBUF_MEM) {
        p->payload = pkt_hdr; // ip hdr or mac hdr
        p->pkt_mac = pkt_mac; // mac hdr
        p->pkt_msg = pkt_msg; // msg ptr
    }
}

static inline void pmsg_pbuf_free_mem(struct pbuf* p)
{
    if(p->type == PBUF_MEM
        && p->pkt_msg
        && p->pkt_msg->free) {
        p->pkt_msg->free(p->pkt_msg);
        p->pkt_msg = 0;
    }
}

