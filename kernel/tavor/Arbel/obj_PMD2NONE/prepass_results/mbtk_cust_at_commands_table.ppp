/*
 * Data Types.
 */
typedef struct
{
    TX_SEMAPHORE    TxRef ;
    UINT          maximumCount ;
	UINT 			waitingMode;
	UINT			reserved;
}
OsaSemaphoreT ;

typedef struct
{
    TX_HISR     TxRef ;
    UINT      intSource ;
    void        (*fisrRoutine)(UINT32) ;
    void        (*sisrRoutine)(void) ;
	UINT		reserved;
}
OsaIsrT ;

typedef struct
{
	TX_QUEUE 	TxRef ;
	UINT 		waitingMode;
	UINT		reserved;
}
OsaMsgQT ;

typedef struct
{
    TX_MUTEX    TxRef ;
	UINT 			waitingMode;
	UINT			reserved;
}
OsaMutexT ;
