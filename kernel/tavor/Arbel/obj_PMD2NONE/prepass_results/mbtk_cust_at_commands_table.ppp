        utlRelativeTime_T  delay_dialing_time;     /* 0.125 seconds fixed        */
        utlRelativeTime_T  min_silence_time;       /* 5.0   seconds fixed        */

    } states;
	OSSemaRef  queue_semaphore;				   /* Used for multiple commands queue operation */
    size_t  commands_in_line;  					   /* the number of commands in one line */

	utlSemaphore_T cmd_cnt_semaphore;                               /* Used for protecting commands_in_line */

	_Bool isProxy; //if set to true - the parser is serving the proxy AT channel

	char basic_command_param[((size_t)1024)] ; /*---proxy str storage--*/

	utlAtCommand_P pProxyOnlyCmd; /*used for handling commands known only to proxy*/

