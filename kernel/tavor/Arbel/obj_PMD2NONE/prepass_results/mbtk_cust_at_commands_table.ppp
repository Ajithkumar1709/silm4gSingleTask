typedef UINT16 CiReturnCode; 

/* CI Shell Operation Code */
//ICAT EXPORTED ENUM
typedef enum CISHOPER {
    CI_SH_OPER_REGISTERSH = 0,
    CI_SH_OPER_DEREGISTERSH,
    CI_SH_OPER_GETVERSION,
