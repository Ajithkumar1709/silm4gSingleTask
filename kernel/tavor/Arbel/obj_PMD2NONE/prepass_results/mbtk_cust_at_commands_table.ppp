utlReturnCode_T AtMbtkCustTest(const utlAtParameterOp_T       op,
                               const char*                    command_name_p,
                               const utlAtParameterValue_P2c  parameter_values_p,
                               const size_t                   num_parameters,
                               const char*                    info_text_p,
                               unsigned int*                  xid_p,
                               void*                          arg_p)
{

    CiRequestHandle atHandle = 0;
    TelAtParserID sAtpIndex = * (TelAtParserID*) arg_p;
    atHandle = (UINT32)( ( ( (UINT32)sAtpIndex << 13) & 0x000FE000 ) | ( ( (UINT32)sAtpIndex>35? 0x40000000:0x0) ) | ( ( (gusXid == 0x1fff)? gusXid=11 : ++gusXid) ) );
    *xid_p = atHandle;

    int ret = -1;
    char ret_buff[64] = {0};

    switch(op)
    {
        case utlAT_PARAMETER_OP_SYNTAX:
        {
            ret = atRespStr( atHandle, ATCI_RESULT_CODE_OK, 0, "MBTK_AT_TEST" );
        }
        break;
        case utlAT_PARAMETER_OP_ACTION:
        {
            ret = atRespStr( atHandle, ATCI_RESULT_CODE_OK, 0, "MBTK_AT_ACTION" );
        }
        break;
        case utlAT_PARAMETER_OP_GET:
        {
	        void mbtk_sleep_debug();
        	mbtk_sleep_debug();
            ret = atRespStr( atHandle, ATCI_RESULT_CODE_OK, 0, "MBTK_AT_GET" );
        }
        break;
        case utlAT_PARAMETER_OP_SET:
        {
            int param1 = 0;
            char param2[128] = {0};
            INT16 param2_len = 0;
            char out_buff[150] = {0};

            DIAG_FILTER(MBTK, ATCI, __FUNCTION__, DIAG_INFORMATION);
            diagPrintf("num_parameters = %d", num_parameters);
            if(getExtValue(parameter_values_p, 0, &param1, 0, 10, 0) == 0)
            {
                ret = atRespStr( atHandle, ATCI_RESULT_CODE_CME_ERROR, CME_INVALID_PARAM, 0 );
                break;
            }
            if(num_parameters > 1)
            {
                if(getExtString(parameter_values_p, 1, param2, 128, &param2_len, 0) == 0)
                {
                    ret = atRespStr( atHandle, ATCI_RESULT_CODE_CME_ERROR, CME_INVALID_PARAM, 0 );
                    break;
                }
                sprintf(out_buff, "param=2,str=%s,int = %d", param2, param1);
            }
            else
            {
                sprintf(out_buff, "param=1,int = %d", param1);
            }
            ret = atRespStr( atHandle, ATCI_RESULT_CODE_OK, 0, out_buff );
        }
        break;
    }

    return ret;
}


# 864 "\\mbtk\\cust_ats\\src\\mbtk_cust_at_commands_table.c"







int mbtk_save_factory_msg_to_fs(char *file_name, char *file_data)
{
    int fd;
    
    if(256 >= FDI_GetFreeSpaceSize())
    {
        ;
        return -1;
    }
    fd = FDI_fopen(file_name, "wb+");
    if (fd <= 0)
    {
        ;
        return -1;
    }
    
    if(FDI_fwrite(file_data, 1, strlen(file_data), fd) <= 0)
    {
        ;
        return -1;
    }
    FDI_fclose(fd);
    return 0;
}
int mbtk_get_factory_msg_from_fs(char *file_name, char *file_data)
{
    int fd;
    fd = FDI_fopen(file_name, "rb+");
    if (fd <= 0)
    {
        ;
        return -1;
    }
    
    if(FDI_fread(file_data, 1, FDI_GetFileSize(fd), fd) <= 0)
    {
        ;
        return -1;
    }
    
    FDI_fclose(fd);
    return 0;
}

utlReturnCode_T AtMbtkCustFactory(const utlAtParameterOp_T       op,
                                const char*                    command_name_p,
                                const utlAtParameterValue_P2c  parameter_values_p,
                                const size_t                   num_parameters,
                                const char*                    info_text_p,
                                unsigned int*                  xid_p,
                                void*                          arg_p)
{
    CiRequestHandle atHandle = 0;
    TelAtParserID sAtpIndex = * (TelAtParserID*) arg_p;
    atHandle = (UINT32)( ( ( (UINT32)sAtpIndex << 13) & 0x000FE000 ) | ( ( (UINT32)sAtpIndex>35? 0x40000000:0x0) ) | ( ( (gusXid == 0x1fff)? gusXid=11 : ++gusXid) ) );
    *xid_p = atHandle;
    
    int ret = -1;
    char resp_buf[256] = {0};
    char product_id[64] = {0};
    char device_name[64] = {0};
    char device_secret[64] = {0};
    
    ;

    switch(op)
    {
        case utlAT_PARAMETER_OP_SYNTAX:
        {
            ;
            ret = atRespStr( atHandle, ATCI_RESULT_CODE_OK, 0, "+FACTORY:<ProductId>,<DeviceName>,<DeviceSecret>" );
            break;
        }
        
        case utlAT_PARAMETER_OP_GET:
        {
            mbtk_get_factory_msg_from_fs("ProductId", product_id);
            mbtk_get_factory_msg_from_fs("DeviceName", device_name);
            mbtk_get_factory_msg_from_fs("DeviceSecret", device_secret);
            
            sprintf(resp_buf, "+FACTORY:<%s>,<%s>,<%s>", product_id, device_name, device_secret);
            ret = atRespStr( atHandle, ATCI_RESULT_CODE_OK, 0, resp_buf );
            break;
        }
        
        case utlAT_PARAMETER_OP_SET:
        {
            int paraStrLength = 0;
            if (getExtString(parameter_values_p, 0, product_id, 64, &paraStrLength, 0) == 0 )
            {
                ret = atRespStr( atHandle, ATCI_RESULT_CODE_CME_ERROR, CME_INVALID_PARAM, 0 );
                break;
            }
            mbtk_save_factory_msg_to_fs("ProductId", product_id);
            if (getExtString(parameter_values_p, 1, device_name, 64, &paraStrLength, 0) == 0 )
            {
                ret = atRespStr( atHandle, ATCI_RESULT_CODE_CME_ERROR, CME_INVALID_PARAM, 0 );
                break;
            }
            mbtk_save_factory_msg_to_fs("DeviceName", device_name);
            if (getExtString(parameter_values_p, 2, device_secret, 64, &paraStrLength, 0) == 0 )
            {
                ret = atRespStr( atHandle, ATCI_RESULT_CODE_CME_ERROR, CME_INVALID_PARAM, 0 );
                break;
            }
            mbtk_save_factory_msg_to_fs("DeviceSecret", device_secret);
            ret = atRespStr( atHandle, ATCI_RESULT_CODE_OK, 0, 0 );
            break;
        }
        default:
        {
            ret = atRespStr( atHandle, ATCI_RESULT_CODE_ERROR, 0, 0 );
            break;
        }
    }

    return ret;
}




# 1057 "\\mbtk\\cust_ats\\src\\mbtk_cust_at_commands_table.c"




utlReturnCode_T AtMbtkCatFS(const utlAtParameterOp_T       op,
                                const char*                    command_name_p,
                                const utlAtParameterValue_P2c  parameter_values_p,
                                const size_t                   num_parameters,
                                const char*                    info_text_p,
                                unsigned int*                  xid_p,
                                void*                          arg_p)
{
    CiRequestHandle atHandle = 0;
    TelAtParserID sAtpIndex = * (TelAtParserID*) arg_p;
    atHandle = (UINT32)( ( ( (UINT32)sAtpIndex << 13) & 0x000FE000 ) | ( ( (UINT32)sAtpIndex>35? 0x40000000:0x0) ) | ( ( (gusXid == 0x1fff)? gusXid=11 : ++gusXid) ) );
    *xid_p = atHandle;
    
    int ret = -1;
	int operation = 0;
	char resp_buf[64] = {0};
	char disable_deivce[20] = {0};
    
	int mbtk_catfs_isdisable(void);
	int mbtk_catfs_disable_str(char *disable_deivce, int buf_size);
	int mbtk_set_catfs_disable_device(char *device);
	int mbtk_catfs_enable(char *device);
    switch(op)
    {
        case utlAT_PARAMETER_OP_SYNTAX:
        {
            ret = atRespStr( atHandle, ATCI_RESULT_CODE_OK, 0, "+CATFS:<oper>,<device>" );
            break;
        }
        
        case utlAT_PARAMETER_OP_GET:
        {            
        	if(mbtk_catfs_isdisable()){
				mbtk_catfs_disable_str(disable_deivce, sizeof(disable_deivce));
            	sprintf(resp_buf, "+CATFS:1,<%s>", disable_deivce);
        	}
			else
				sprintf(resp_buf, "+CATFS:0");
			
            ret = atRespStr( atHandle, ATCI_RESULT_CODE_OK, 0, resp_buf );
            break;
        }
        
        case utlAT_PARAMETER_OP_SET:
        {
            int paraStrLength = 0;

			
            if(getExtValue(parameter_values_p, 0, &operation, 0, 1, 0) == 0)
			{
                ret = atRespStr( atHandle, ATCI_RESULT_CODE_CME_ERROR, CME_INVALID_PARAM, 0 );
                break;
            }
			
           
			if (getExtString(parameter_values_p, 1, disable_deivce, 4, &paraStrLength, 0) == 0 )
            {
                ret = atRespStr( atHandle, ATCI_RESULT_CODE_CME_ERROR, CME_INVALID_PARAM, 0 );
                break;
            }


			if(operation == 0){
				if(strlen(disable_deivce)==0)
					ret = mbtk_catfs_enable(0);
				else
					ret = mbtk_catfs_enable(disable_deivce);
				
			}else{
				ret = mbtk_set_catfs_disable_device(disable_deivce);
			}
			
			if(ret == 0)
				ret = atRespStr( atHandle, ATCI_RESULT_CODE_OK, 0, 0 );
			else
            	ret = atRespStr( atHandle, ATCI_RESULT_CODE_ERROR, 0, 0 );
            break;
        }
        default:
        {
            ret = atRespStr( atHandle, ATCI_RESULT_CODE_ERROR, 0, 0 );
            break;
        }
    }

    return ret;
}

