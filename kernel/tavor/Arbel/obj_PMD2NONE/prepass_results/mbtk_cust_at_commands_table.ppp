	UINT8   ulTimeUnit; /**<0 -unrestricted, 1 -minute, 2 -hour, 3 -day, 4- week */
	UINT32  maxUlRate;  /**< specifies the time unit to be used for the max uplink rate */
}CiPsApnRateCtrlnfo;

/* <INUSE> */
