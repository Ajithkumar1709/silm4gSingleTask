    utlAtSoundConfig_T  sound_config;

    utlAtCommand_P2c commands_p[3];    /* pointer to a variable-length array                  */
    size_t           num_commands[3];  /* number of array elements pointed to by `commands_p' */
    size_t           command_list_count;  /* number of array elements pointed to by `commands_p' */

