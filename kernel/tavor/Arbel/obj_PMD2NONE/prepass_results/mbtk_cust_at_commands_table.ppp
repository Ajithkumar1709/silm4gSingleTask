    //CiPsPdpAddrMask  	srcAddrMask;   				/**< Source address mask - subnet mask \sa CiPsPdpAddrMask */
    CiPsTftDirectionIndicationType  direction;					/**< specifies the transmission direction in which the packet filter shall be applied */
