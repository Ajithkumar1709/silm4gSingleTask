    UINT32                      Size                //  [IN]    Number of bytes to be allocated.
    ) ;

 extern BOOL        OsaMemAllocAgain(
    void                        *pMem               //  [IN]    Pointer to the memory to be allocated again.
    ) ;

 extern OSA_STATUS  OsaMemCreatePool(
