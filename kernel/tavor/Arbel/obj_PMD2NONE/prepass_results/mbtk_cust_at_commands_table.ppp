//ICAT EXPORTED STRUCT
typedef struct CiMmPrimEmergencyCallStatusCnf_struct
{
    CiMmResultCode  result;
    CiMmAccTechMode act;
    CiMmEccCnfActStatus actStatus;  
}CiMmPrimEmergencyCallStatusCnf;



