    utlSecond_T     seconds;
    utlNanosecond_T nanoseconds;
}             utlRelativeTime_T, *utlRelativeTime_P;
typedef const utlRelativeTime_T  *utlRelativeTime_P2c;

/*--- epoch-referenced absolute time ---*/
