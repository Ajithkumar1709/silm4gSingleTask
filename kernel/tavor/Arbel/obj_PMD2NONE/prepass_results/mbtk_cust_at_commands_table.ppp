    CiNumericRange   srcPortRange;  		/**< Source port range \sa CCI API Ref Manual */
    CiBoolean		 srcPortRangePresent; /**< TRUE: if present \sa CCI API Ref Manual */ //Michal

    UINT32           ipSecSPI;      		/**< IPSec security parameter index */
