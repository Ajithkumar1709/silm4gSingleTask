    void                        *pForFutureUse
    ) ;

 extern OSA_STATUS  OsaMailboxQRecv(
    OsaRefT                     OsaRef,             //  [IN]    Reference.
    UINT32                      *mboxData,          //  [OT]    Data read from mailbox.
