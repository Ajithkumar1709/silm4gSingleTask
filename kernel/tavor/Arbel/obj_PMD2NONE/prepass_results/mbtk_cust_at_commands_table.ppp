    CIPS_IMS_REG_STATE_REG_COMPLETED = 6,       /**< IMS register completed. Not used.*/
    CIPS_IMS_REG_STATE_DEREG_COMPLETED = 7,     /**< IMS de-register completed. Not used.*/

