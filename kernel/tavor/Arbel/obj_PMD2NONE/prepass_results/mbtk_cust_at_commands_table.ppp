  UINT8 	month;          	/**< Month  [ 1..12 ] */
  UINT8 	day;            		/**< Day    [ 1..31 ] */
  UINT8 	hour;           		/**< Hour   [ 0..59 ] */
  UINT8 	minute;         	/**< Minute [ 0..59 ] */
  UINT8 	second;         	/**< Second [ 0..59 ] */
