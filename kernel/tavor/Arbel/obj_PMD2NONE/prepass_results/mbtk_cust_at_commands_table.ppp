    UINT8     nwBear;
    CiBoolean dsmIpv6HaPresent;
    UINT8     dsmIpv6Ha;
    CiBoolean dsmIpv6PrefPresent;
    UINT8     dsmIpv6Pref;
    CiBoolean dsmIpv6HaIpv4Present;
    UINT8     dsmIpv6HaIpv4;
    CiBoolean ipViaNasPresent;
    UINT8     ipViaNas;
    CiBoolean ipViaDhcpPresent;
    UINT8     ipViaDhcp;
    CiBoolean pcscfIpv4Present;
    UINT8     pcscfIpv4;
    CiBoolean dnsIpv4Present;
